      "research_observation_refs": ["o-packing"],
      "source_refs": ["cleafy-2024", "threatfabric-c"],
      "investigation_seeds": {
        "any_of": [
          {"kind": "research_indicator", "indicator_set_ref": "cleafy-artifacts", "value": "assets/base.apk"},
          {"kind": "research_indicator", "indicator_set_ref": "cleafy-artifacts", "value": "com.turkey.inner.Uactortrust"},
          {"kind": "research_indicator", "indicator_set_ref": "cleafy-artifacts", "value": "/data/user/0/dreammes.ross431.in/app_inflict/wF.json"},
          {"kind": "research_indicator", "indicator_set_ref": "variant-c-artifacts", "value": "dex.module"},
          {"kind": "apk_capability", "value": "dynamic code loading"}
        ],
        "minimum": 1
      },
      "required_nodes": [
        {"node_id": "payload-source", "role": "source", "description": "Embedded, downloaded or locally reconstructed executable payload", "acceptable_evidence": ["asset/file provenance", "network-to-file flow"]},
        {"node_id": "recovery", "role": "transform", "description": "Decode, decrypt, unpack or extract payload", "acceptable_evidence": ["bounded call/data flow", "written executable bytes"]},
        {"node_id": "loader", "role": "sink", "description": "Android runtime loads executable code", "acceptable_evidence": ["resolved class-loader or package-loading call"]}
      ],
      "required_edges": [
        {"from": "payload-source", "to": "recovery", "relation": "data_flows_to", "required": true},
        {"from": "recovery", "to": "loader", "relation": "loaded_by", "required": true}
      ],
      "optional_support": ["malformed archive structure", "JSONPacker marker", "loadModule command", "payload package name"],
      "support_rule": "RELATIONSHIP_SUPPORTED requires payload provenance and the recovered artifact flowing to a loader.",
      "partial_rule": "A .dex/.apk string, packer name, class-loader API, or matching path alone is an investigation seed.",
      "non_claims": ["The loaded code is malicious without inspecting it", "A malformed archive proves TrickMo", "The app is TrickMo"]
    },
