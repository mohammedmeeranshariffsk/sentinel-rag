{
  "schema_version": "0.1-draft",
  "status": "research_only_not_loaded_by_runtime",
  "family_id": "family:trickmo",
  "template_contract": {
    "seed_meaning": "A seed selects APK locations for investigation; it does not prove a behavior or family.",
    "relationship_meaning": "A relationship is supported only when program analysis resolves the required nodes and edges in one compatible APK context.",
    "outcomes": ["NO_SEED", "INDICATOR_MATCH", "APK_COOCCURRENCE", "PARTIAL_RELATIONSHIP", "RELATIONSHIP_SUPPORTED", "NOT_VERIFIABLE"],
    "family_attribution": "Out of scope for an individual behavior template."
  },
  "templates": [
    {
      "template_id": "verify:trickmo:credential-overlay:v1",
      "behavior_id": "behavior:credential-overlay",
      "title": "Package-targeted credential overlay",
      "applicable_cohorts": ["cleafy-2024-scope", "zimperium-2024-scope", "threatfabric-c-scope"],
      "research_observation_refs": ["o-overlay", "o-pin"],
      "source_refs": ["cleafy-2024", "zimperium-2024", "threatfabric-c"],
      "investigation_seeds": {
        "any_of": [
          {"kind": "research_indicator", "indicator_set_ref": "cleafy-artifacts", "value": "SaveHtml"},
          {"kind": "research_indicator", "indicator_set_ref": "zimperium-bridge", "value": "getAndroidID"},
          {"kind": "apk_capability", "value": "WebView content loading"},
          {"kind": "apk_capability", "value": "draw-over-apps or fullscreen overlay component"}
        ],
        "minimum": 1
      },
      "required_nodes": [
        {"node_id": "target-context", "role": "context", "description": "Foreground/installed package or unlock context selects an overlay", "acceptable_evidence": ["local call/data flow", "component/lifecycle relationship"]},
        {"node_id": "deceptive-ui", "role": "transform", "description": "HTML/WebView or equivalent UI presents credential/unlock input", "acceptable_evidence": ["bundled asset", "downloaded content with resolved use", "WebView configuration and input fields"]},
        {"node_id": "entered-secret", "role": "source", "description": "User-entered credential, PIN or pattern", "acceptable_evidence": ["WebView bridge flow", "form/JavaScript input flow", "native UI input flow"]},
        {"node_id": "remote-send", "role": "sink", "description": "Entered value reaches a network request", "acceptable_evidence": ["bounded data flow to network API", "resolved JavaScript request"]}
      ],
      "required_edges": [
        {"from": "target-context", "to": "deceptive-ui", "relation": "selects_or_triggers", "required": true},
        {"from": "deceptive-ui", "to": "entered-secret", "relation": "collects", "required": true},
        {"from": "entered-secret", "to": "remote-send", "relation": "data_flows_to", "required": true}
      ],
      "optional_support": ["device identifier joins the request", "overlay permission/configuration", "target package list", "source-backed research tokens"],
      "support_rule": "RELATIONSHIP_SUPPORTED requires all four nodes and all three edges in the same compatible APK/module context.",
      "partial_rule": "A WebView, overlay permission, SaveHtml, getAndroidID, or target list alone is INDICATOR_MATCH or APK_COOCCURRENCE.",
      "non_claims": ["The app steals credentials without a verified input-to-network edge", "The app is TrickMo", "The flow executes at runtime"]
    },
    {
      "template_id": "verify:trickmo:packed-payload-loading:v1",
      "behavior_id": "behavior:packed-payload-loading",
